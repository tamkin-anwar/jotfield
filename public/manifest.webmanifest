{
  "name": "Jotfield",
  "id": "./",
  "short_name": "Jotfield",
  "description": "A place for every thought.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "note_taking": { "new_note_url": "./?new=1" },
  "shortcuts": [
    { "name": "Quick Jot", "short_name": "Quick Jot", "url": "./?quick=1", "icons": [{ "src": "./jotfield-icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "New note", "short_name": "New note", "url": "./?new=1", "icons": [{ "src": "./jotfield-icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ],
  "background_color": "#f5efe4",
  "theme_color": "#ff5c35",
  "icons": [
    {
      "src": "./jotfield-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
